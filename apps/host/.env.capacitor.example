# Capacitor Android development configuration
# Copy this file to .env.development.local to override the default dev URLs:
#   copy .env.capacitor.example .env.development.local
#
# Uses 10.0.2.2 (Android emulator's alias for host machine's localhost)
# so the Android WebView can reach the Vite dev servers running on your machine.

VITE_REMOTE1_URL=http://10.0.2.2:5001/assets/remoteEntry.js
VITE_REMOTE2_URL=http://10.0.2.2:5002/assets/remoteEntry.js
VITE_HOST_URL=http://10.0.2.2:5000
VITE_REMOTE1_PROXY_PATH=http://10.0.2.2:5001/
VITE_REMOTE2_PROXY_PATH=http://10.0.2.2:5002/
